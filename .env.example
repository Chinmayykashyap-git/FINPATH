# ============================================================================
# FINPATH AI — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and customize values before deploying to production.
# ============================================================================

# Application Metadata
PROJECT_NAME="FinPath AI — Transaction Intelligence Platform"
ENVIRONMENT="production"

# Authentication & JWT Security (REQUIRED in production: generate with `openssl rand -hex 32`)
JWT_SECRET_KEY="replace_with_a_strong_cryptographic_secret_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# Default uses persistent SQLite. For PostgreSQL in production, set:
# DATABASE_URL="postgresql+psycopg2://finpath_user:finpath_pass@postgres:5432/finpath_db"
DATABASE_URL="sqlite:///./data/finpath.db"

# Number of synthetic transactions to index in SQLite on first boot (5000 to 200000)
DB_SEED_LIMIT=25000

# Optional custom password for the demo account (otherwise randomly generated at boot)
DEMO_ACCOUNT_PASSWORD=""

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Frontend build-time API URL (leave empty when using Nginx reverse proxy or Vite dev proxy)
VITE_API_BASE_URL=""

